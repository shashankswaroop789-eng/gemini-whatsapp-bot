<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="36dp">

        <!-- 1. ATELIER LUXURY HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Watchmaker Precision Chrono Dial & Halo -->
            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginEnd="16dp">

                <!-- Breathing Aura Halo -->
                <View
                    android:id="@+id/glowRing"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_chrono_halo" />

                <!-- Rotating Dashed Tourbillon Dial -->
                <View
                    android:id="@+id/dialRing"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_chrono_dial" />

                <!-- Central Titanium Jewel -->
                <View
                    android:id="@+id/coreOrb"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_chrono_core" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GEMINI ATELIER"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/accent_titanium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PROTECTED"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:textColor="@color/accent_moonstone"
                        android:background="@drawable/bg_badge_titanium"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_chrono_core"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvStatusSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Neural Shield Active • Zero Repetition"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sync Button -->
            <ImageButton
                android:id="@+id/btnHeaderUpdate"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_outline"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/accent_titanium"
                android:padding="10dp"
                android:contentDescription="Check for updates" />
        </LinearLayout>

        <!-- 2. LUXURY TELEMETRY BAR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_glass"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Stat 1: Messages Monitored -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatHeard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCANNED"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/stroke_divider" />

                <!-- Stat 2: Replies Sent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatReplied"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="bold"
                        android:textColor="@color/accent_titanium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISPATCHED"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/stroke_divider" />

                <!-- Stat 3: Loops Prevented -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatLoops"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-light"
                        android:textStyle="bold"
                        android:textColor="@color/accent_orange" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SHIELDED"
                        android:textSize="9sp"
                        android:letterSpacing="0.12"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 3. RECENT LIVE ACTIVITY CHRONICLE -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_glass"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACTIVITY CHRONICLE"
                        android:textSize="11sp"
                        android:letterSpacing="0.15"
                        android:textStyle="bold"
                        android:textColor="@color/accent_moonstone" />

                    <TextView
                        android:id="@+id/tvFeedCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAST 10 • SCROLLABLE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_silver"
                        android:background="@drawable/bg_badge_titanium"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/btnClearHistory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="PURGE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_tertiary"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <!-- DEDICATED SCROLLABLE FEED CONTAINER (LAST 10) -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scrollActivityFeed"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:fillViewport="true"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false">

                    <LinearLayout
                        android:id="@+id/llActivityFeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNoActivity"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="20dp"
                            android:gravity="center"
                            android:text="Awaiting incoming WhatsApp transmissions..."
                            android:textSize="12sp"
                            android:textColor="@color/text_tertiary" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </FrameLayout>

        <!-- 4. SYSTEM PREFERENCES & CONTROLS -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_glass"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SYSTEM PREFERENCES"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textStyle="bold"
                    android:textColor="@color/accent_moonstone"
                    android:layout_marginBottom="14dp" />

                <!-- API Key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEMINI API KEY"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/apiKeyInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:hint="Paste Gemini API Key from Google AI Studio"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input_luxury"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp" />

                <!-- Personality Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="RESPONSE PERSONA"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <RadioGroup
                    android:id="@+id/radioGroupPersona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_input_luxury"
                    android:padding="4dp">

                    <RadioButton
                        android:id="@+id/radioGrok"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✨ Grok Mode (Witty, clever &amp; de-escalating)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true"
                        android:padding="8dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/stroke_divider" />

                    <RadioButton
                        android:id="@+id/radioProfessional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎩 Executive Mode (Concise, polished &amp; polite)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:padding="8dp" />
                </RadioGroup>

                <!-- Voice Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Voice Acoustic Briefing\n(Speaks incoming msg &amp; outgoing reply)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:checked="true"
                    app:thumbTint="@color/accent_titanium"
                    app:trackTint="@color/stroke_titanium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_divider"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Auto-Reply Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleAutoReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Auto-Reply Active\n(Enforces anti-flood shield &amp; loop protection)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:checked="true"
                    app:thumbTint="@color/accent_titanium"
                    app:trackTint="@color/stroke_titanium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_divider"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Group Chat Filter Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleIgnoreGroups"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Only 1-on-1 Direct Chats\n(Ignore WhatsApp group chats completely)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:checked="true"
                    app:thumbTint="@color/accent_titanium"
                    app:trackTint="@color/stroke_titanium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_divider"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Language Chameleon Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleChameleon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Language Chameleon (Hinglish &amp; Hindi)\n(Auto-matches sender's Hindi/Hinglish dialect)"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:checked="true"
                    app:thumbTint="@color/accent_titanium"
                    app:trackTint="@color/stroke_titanium" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_divider"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <!-- Exclusion Blacklist -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="EXCLUSION BLACKLIST (NEVER REPLY)"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etBlacklist"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Boss, HDFC, SBI, OTP, Alert, Swiggy"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_luxury"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="12sp" />

                <!-- VIP Relationship Profiles -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="VIP RELATIONSHIPS (CUSTOM TONE)"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etVipProfiles"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:hint="e.g. Dad: Parent, Viditi: Partner, Bhai: Friend"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_input_luxury"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_divider"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <!-- Neural Voice Persona Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="NEURAL VOICE PERSONA (HUMAN AI VOICE)"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Studio-grade neural voice with natural breathing &amp; inflection"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary" />

                <RadioGroup
                    android:id="@+id/radioGroupVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/radioVoiceAoede"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🌸 Aoede (Warm Female • Gemini Live / GPT Sky style)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:checked="true"
                        android:buttonTint="@color/accent_titanium"
                        android:padding="6dp" />

                    <RadioButton
                        android:id="@+id/radioVoicePuck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎙️ Puck (Conversational Male • Gemini Live / GPT Breeze style)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:buttonTint="@color/accent_titanium"
                        android:padding="6dp" />

                    <RadioButton
                        android:id="@+id/radioVoiceCharon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🎩 Charon (Deep &amp; Calm Male • Executive Persona)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:buttonTint="@color/accent_titanium"
                        android:padding="6dp" />

                    <RadioButton
                        android:id="@+id/radioVoiceNeerja"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🇮🇳 Neerja (Indian Hinglish &amp; English Natural Tone)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:buttonTint="@color/accent_titanium"
                        android:padding="6dp" />
                </RadioGroup>

                <!-- Audition Voice Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAuditionVoice"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:text="🔊 AUDITION SELECTED AI VOICE"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/accent_titanium"
                    android:background="@drawable/bg_input_luxury" />

                <!-- Voice Cadence Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ACOUSTIC CADENCE"
                        android:textSize="10sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvVoiceRateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent_titanium" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarVoiceRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="10"
                    android:progress="4"
                    android:thumbTint="@color/accent_titanium"
                    android:progressTint="@color/accent_silver"
                    android:progressBackgroundTint="@color/stroke_titanium"
                    android:layout_marginTop="8dp" />

                <!-- Action Buttons -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Save Configuration"
                    android:textColor="#0B0C10"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold"
                    android:background="@drawable/bg_btn_titanium" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPermission"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="Verify Notification Access"
                    android:textColor="@color/accent_silver"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:background="@drawable/bg_btn_outline" />
            </LinearLayout>
        </FrameLayout>

        <!-- 5. REFINED OTA FOOTER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvVersionTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version v1.0.0 (Titanium)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Autonomous OTA updater enabled"
                        android:textSize="11sp"
                        android:textColor="@color/text_tertiary" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Check Release"
                    android:textColor="@color/accent_titanium"
                    android:textSize="11sp"
                    android:background="@drawable/bg_btn_outline"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
